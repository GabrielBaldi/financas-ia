# Copie para api/.env e ajuste. Nenhum valor aqui é segredo de verdade.

# SQLite local (padrão). Em produção, a URL do Postgres (postgres://... também é aceita).
DATABASE_URL=sqlite:///./financas.db

# Origens do front-end autorizadas pelo CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:5102

# IA (opcional). Sem chave, a IA fica desligada: o que as regras não reconhecem vai para
# "A revisar". AI_PROVIDER vazio escolhe sozinho: Claude se ANTHROPIC_API_KEY estiver
# preenchida, senão NVIDIA se NVIDIA_API_KEY estiver. Use anthropic ou nvidia para fixar.
AI_PROVIDER=
AI_MIN_CONFIDENCE=0.7
# Tempo máximo de cada requisição à IA; passou disso, o lote vai para "A revisar".
AI_TIMEOUT_SECONDS=60

# Anthropic (Claude), o provedor padrão.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# Preço do Claude em US$ por milhão de tokens, só para estimar o custo de cada importação.
AI_INPUT_PRICE_PER_MTOK=0.10
AI_OUTPUT_PRICE_PER_MTOK=0.50

# NVIDIA (API hospedada em build.nvidia.com, compatível com OpenAI). A chave começa com nvapi-.
# Sem preço configurado: os tokens são salvos, mas o custo não é estimado.
NVIDIA_API_KEY=
NVIDIA_MODEL=minimaxai/minimax-m3.1-flash

# Opcional. Token do bot do Telegram, gerado pelo @BotFather (veja o README). Só o processo
# `uv run python -m financas.telegram_bot` usa; a API não precisa dele.
TELEGRAM_BOT_TOKEN=
