# Copie para api/.env e ajuste. Nenhum valor aqui é segredo de verdade.

# SQLite local (padrão). Em produção, a URL do Postgres (postgres://... também é aceita).
DATABASE_URL=sqlite:///./financas.db

# Origens do front-end autorizadas pelo CORS, separadas por vírgula.
CORS_ORIGINS=http://localhost:5102

# Opcional. Sem chave, a IA fica desligada: o que as regras não reconhecem vai para "A revisar".
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
AI_MIN_CONFIDENCE=0.7

# Preço do modelo em US$ por milhão de tokens, só para estimar o custo de cada importação.
AI_INPUT_PRICE_PER_MTOK=0.10
AI_OUTPUT_PRICE_PER_MTOK=0.50
